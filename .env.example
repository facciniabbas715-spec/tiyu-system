# AI 智能客服配置示例（复制为环境变量使用，切勿把真实 Key 提交到 Git）
#
# PowerShell 示例：
#   $env:AI_API_KEY="sk-xxxx"
#   $env:AI_BASE_URL="https://api.openai.com"
#   $env:AI_MODEL="gpt-4o-mini"
#
# 常见 OpenAI 兼容服务商：
#   OpenAI    : AI_BASE_URL=https://api.openai.com
#   DeepSeek  : AI_BASE_URL=https://api.deepseek.com                  AI_MODEL=deepseek-chat
#   DashScope : AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus

AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
